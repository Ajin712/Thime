{
  "app": "python app.py",
  "watch": {
    "include": ["**"],
    "exclude": [
      "README.md",
      "cdk*.json",
      "**/__pycache__/**",
      "**/.venv/**"
    ]
  },
  "context": {
    "region": "ap-northeast-2",
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:checkSecretAccess": true,
    "@aws-cdk/aws-s3:keepNotificationInImportedBucket": false
  }
}
